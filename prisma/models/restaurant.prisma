enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Restaurant {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  status        RestaurantStatus @default(ACTIVE)
  deliveryPrice Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  users           User[]
  categories      Category[]
  products        Product[]
  productVariants ProductVariant[]
}
