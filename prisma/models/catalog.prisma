model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, id])
  @@index([restaurantId, sortOrder, id])
}

model Product {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?  @db.Text
  baseComposition String?  @db.Text
  imageUrl        String?
  imageKey        String?
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [restaurantId, categoryId], references: [restaurantId, id], onDelete: Restrict)
  variants   ProductVariant[]
  removableIngredients ProductRemovableIngredient[]
  addons                ProductAddon[]

  @@unique([restaurantId, id])
  @@index([restaurantId, categoryId, sortOrder, id])
  @@index([restaurantId, isPublished, sortOrder, id])
  @@index([restaurantId, isAvailable, sortOrder, id])
}

model Ingredient {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  removableFrom ProductRemovableIngredient[]

  @@unique([restaurantId, id])
  @@index([restaurantId, name, id])
}

model ProductRemovableIngredient {
  id           String                @id @default(cuid())
  restaurantId String
  productId    String
  ingredientId String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [restaurantId, ingredientId], references: [restaurantId, id], onDelete: Restrict)

  @@unique([restaurantId, productId, ingredientId])
  @@index([restaurantId, productId, id])
  @@index([restaurantId, ingredientId, id])
}

model ProductAddon {
  id           String   @id @default(cuid())
  restaurantId String
  productId    String
  addonId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)
  addon      Addon      @relation(fields: [restaurantId, addonId], references: [restaurantId, id], onDelete: Restrict)

  @@unique([restaurantId, productId, addonId])
  @@index([restaurantId, productId, id])
  @@index([restaurantId, addonId, id])
}

model ProductVariant {
  id           String   @id @default(cuid())
  restaurantId String
  productId    String
  name         String?
  price        Int
  weight       String?
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)

  @@index([restaurantId, productId, sortOrder, id])
  @@index([restaurantId, isAvailable, productId])
}
